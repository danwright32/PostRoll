venv/
output/
__pycache__/
*.pyc
.DS_Store

# App data and client files — keep local only
events.json
events.json.bak
events.json.bak.*
programs/
photos/
audio/

# Build artifacts
Test2
build/
PostRollApp/build/
# Where CI points xcodebuild so the compiled products can be cached (#430).
PostRollApp/.derived-data/

# Local generation outputs and logs
logs/
preview/

# Editor/agent local state
PostRollApp/.claude/

# Local scratch that is not part of the product (#170). These sit in the
# working tree and were false-tripping the pre-push style gate, which scans
# untracked files, so a clean push was blocked by files unrelated to it.
canvas.png
collage-check.png
export-preview.txt
.playwright-mcp/

# Standalone localhost collage editor: a prototype superseded by the in-app
# SwiftUI editor, which is the source of truth for collage geometry. Kept on
# disk, deliberately not part of the repo.
scripts/

# Xcode per-user editor state: which files were open, window positions, scheme
# ordering. It changes on every launch, belongs to one Mac, and conflicts on
# every merge. The project itself is generated from project.yml, so nothing
# here is needed to build (#120).
**/xcuserdata/
*.xcuserstate

# iCloud conflict copies. This repo lives under ~/Documents, which has Desktop
# and Documents sync switched on, so iCloud resolves a sync race by writing a
# second copy beside the original with a number appended ("DesignStamp 2.swift",
# "PostRoll 2.xcodeproj"). Six of them accumulated in the working tree, two of
# which were copies of the very files an open issue was about, so a search could
# match a stale copy and an edit could land in a file nothing builds. They are
# never wanted in the repo. Note this only hides them from git: the copies are
# still written to disk, and iCloud also makes them inside .git itself, which
# git never tracks and this cannot reach.
*[ ][0-9]
*[ ][0-9].*
*.icloud
